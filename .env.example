# Copy to .env for local runs. In Azure these are set on the Container App.

PORT=8000
CUEFX_HOST=127.0.0.1
CUEFX_PORT=8000

# Uploaded clips, cache, renders and jobs. On Azure this is the container disk
# (lost on restart, revision swap or a new replica). Keep one replica.
CUEFX_DATA_DIR=/data

# Look images (<look>.png) listed by GET /api/looks. Same ephemeral disk.
CUEFX_LOOKS_DIR=/data/looks

# Stand-in look image (part of the make key). Default: <data>/look/standin_orb.png
# CUEFX_LOOK_IMAGE=

# Comma-separated frontend origins allowed by CORS
CUEFX_CORS_ORIGINS=http://localhost:5173

CUEFX_MAX_UPLOAD_MB=500

# Experimental one-click image-edit + main/reverse LTX route
CUEFX_LTX_OVERLAP_ENABLED=0
# CUEFX_COMFY_URL=
# CUEFX_COMFY_TOKEN=
CUEFX_COMFY_TIMEOUT_S=7200
